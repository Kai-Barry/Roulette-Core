// Wheel templates (blueprint §4.6 + §7.1, TASK-011). `numbers` is the physical
// slot order; colors are explicit per slot so the runtime config is fully
// data-defined. Special slots (gold/purple/cyan/crimson) are overrides.
(
    schema_version: 1,
    wheels: [
        // ---- COMMON (starter drafts / free, §4.6) ----
        (id: "classic", name: "The Gilded Classic",
         description: "Standard 37-slot European layout. Balanced and reliable.",
         numbers: [0, 32, 15, 19, 4, 21, 2, 25, 17, 34, 6, 27, 13, 36, 11, 30, 8, 23, 10, 5, 24, 16, 33, 1, 20, 14, 31, 9, 22, 18, 29, 7, 28, 12, 35, 3, 26],
