// Enemies (blueprint §7.1, all 6, TASK-011): 4-move looping intent patterns,
// EV-AI difficulty per §7.4.
(
    schema_version: 1,
    enemies: [
        (id: "decay_wheel", name: "Decay Wheel", max_hp: 50, tier: normal, wheel_id: "dozen",
         sprite_name: "decay",
         intent_pattern: (
             (action: attack, value: 6, description: "will take 6 points"),
             (action: steal_chips, value: 5, description: "will steal 5 chips"),
             (action: attack, value: 8, description: "will take 8 points"),
             (action: physics_debuff, value: 3, description: "will gum the wheel"),
         ),
         difficulty: 0.25),
        (id: "grave_croupier", name: "Grave Croupier", max_hp: 40, tier: normal, wheel_id: "classic",
         sprite_name: "croupier",
         intent_pattern: (
             (action: steal_chips, value: 4, description: "will skim 4 chips"),
             (action: attack, value: 5, description: "will take 5 points"),
             (action: shield, value: 6, description: "will hedge 6"),
             (action: attack, value: 7, description: "will take 7 points"),
         ),
         difficulty: 0.3),
        (id: "blood_wraith", name: "Blood Wraith", max_hp: 60, tier: normal, wheel_id: "classic",
         sprite_name: "wraith",
         intent_pattern: (
             (action: attack, value: 9, description: "will take 9 points"),
             (action: buff, value: 3, description: "will sharpen its odds"),
             (action: attack, value: 10, description: "will take 10 points"),
             (action: physics_debuff, value: 4, description: "will rust your track"),
         ),
         difficulty: 0.35),
        (id: "dread_gambler", name: "Dread Gambler", max_hp: 45, tier: normal, wheel_id: "classic",
         sprite_name: "gambler",
         intent_pattern: (
             (action: attack, value: 7, description: "will take 7 points"),
             (action: attack, value: 5, description: "will take 5 points"),
             (action: steal_chips, value: 6, description: "will steal 6 chips"),
             (action: block_red, value: 2, description: "will block your reds"),
         ),
         difficulty: 0.25),
        (id: "dealers_claw", name: "The Dealer's Claw", max_hp: 95, tier: elite, wheel_id: "dealers_claw",
         sprite_name: "claw",
         intent_pattern: (
             (action: attack, value: 14, description: "will take 14 points"),
             (action: steal_chips, value: 10, description: "will steal 10 chips"),
             (action: shield, value: 8, description: "will hedge 8"),
             (action: attack, value: 16, description: "will take 16 points"),
         ),
         difficulty: 0.85),
        (id: "the_house", name: "THE HOUSE", max_hp: 220, tier: boss, wheel_id: "the_house",
         sprite_name: "house",
         intent_pattern: (
             (action: attack, value: 20, description: "will take 20 points"),
             (action: steal_chips, value: 15, description: "will drain 15 chips"),
             (action: physics_debuff, value: 6, description: "will corrupt your physics"),
             (action: attack, value: 18, description: "will take 18 points"),
         ),
         difficulty: 1.0),
    ],
)