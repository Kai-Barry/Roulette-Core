// Wave-1 card content (blueprint §6.3, TASK-010): ≈55 cards spanning every
// §6.4 hook, with verbatim effect numbers. Effects are EffectKind DSL data —
// adding a card needs zero Rust changes (REQ-001).
(
    schema_version: 1,
    cards: [
        // ============ PAYOUT (§6.3 payout table) ============
        (id: "crimson_double", name: "Crimson Surge", cost: 1, card_type: payout, rarity: common,
         description: "Red bets deal 2.5x damage instead of 2.0x for the rest of the fight.",
         effects: [payout_mult(target: red, value: 2.5, duration: fight)]),
        (id: "dark_fury", name: "Dark Fury", cost: 1, card_type: payout, rarity: common,
         description: "Black bets deal 2.5x damage instead of 2.0x for the rest of the fight.",
         effects: [payout_mult(target: black, value: 2.5, duration: fight)]),
        (id: "green_greed", name: "Green Greed", cost: 1, card_type: payout, rarity: rare,
         description: "Green bets deal 50x damage instead of 14x for the next 3 spins.",
         effects: [payout_mult(target: green, value: 50.0, duration: spins(3))]),
        (id: "lucky_seven", name: "Lucky Number 7", cost: 2, card_type: payout, rarity: rare,
         description: "Number 7 bets deal 200x damage for the rest of the fight.",
         effects: [custom_number_mult(numbers: [7], mult: 200.0)]),
        (id: "scarlet_overflow", name: "Scarlet Overflow", cost: 1, card_type: payout, rarity: uncommon,
         description: "Red bets deal 3.0x damage, but Black bets deal 1.0x for the next 5 spins.",
         effects: [payout_mult(target: red, value: 3.0, duration: spins(5)),
                   payout_mult(target: black, value: 1.0, duration: spins(5))]),
        (id: "onyx_eclipse", name: "Onyx Eclipse", cost: 1, card_type: payout, rarity: uncommon,
         description: "Black bets deal 3.0x damage, but Red bets deal 1.0x for the next 5 spins.",
         effects: [payout_mult(target: black, value: 3.0, duration: spins(5)),
                   payout_mult(target: red, value: 1.0, duration: spins(5))]),
        (id: "unlucky_thirteen", name: "Unlucky 13", cost: 2, card_type: payout, rarity: legendary,
         description: "Number 13 bets deal 300x damage for the rest of the fight.",
         effects: [custom_number_mult(numbers: [13], mult: 300.0)]),
        (id: "prime_target", name: "Prime Target", cost: 2, card_type: payout, rarity: uncommon,
         description: "Prime number bets deal 3.5x damage for the next 3 spins.",
         effects: [payout_mult(target: prime, value: 3.5, duration: spins(3))]),
        (id: "high_roller", name: "High Roller", cost: 2, card_type: payout, rarity: common,
         description: "High numbers (19-36) deal 2.5x damage for the next 3 spins.",
         effects: [payout_mult(target: high, value: 2.5, duration: spins(3))]),
        (id: "low_sweep", name: "Low Sweep", cost: 2, card_type: payout, rarity: common,
         description: "Low numbers (1-18) deal 2.5x damage for the next 3 spins.",
         effects: [payout_mult(target: low, value: 2.5, duration: spins(3))]),
        (id: "even_split", name: "Even Split", cost: 1, card_type: payout, rarity: common,
         description: "Even numbers deal 2.5x damage for the next 3 spins.",
         effects: [payout_mult(target: even, value: 2.5, duration: spins(3))]),
        (id: "odd_advantage", name: "Odd Advantage", cost: 1, card_type: payout, rarity: common,
         description: "Odd numbers deal 2.5x damage for the next 3 spins.",
         effects: [payout_mult(target: odd, value: 2.5, duration: spins(3))]),
        (id: "first_dozen", name: "First Dozen", cost: 2, card_type: payout, rarity: uncommon,
         description: "Bets on Dozen 1-12 deal 3.5x damage for the next 3 spins.",
         effects: [payout_mult(target: dozen(1), value: 3.5, duration: spins(3))]),
        (id: "second_dozen", name: "Second Dozen", cost: 2, card_type: payout, rarity: uncommon,
         description: "Bets on Dozen 13-24 deal 3.5x damage for the next 3 spins.",
         effects: [payout_mult(target: dozen(2), value: 3.5, duration: spins(3))]),
        (id: "third_dozen", name: "Third Dozen", cost: 2, card_type: payout, rarity: uncommon,
         description: "Bets on Dozen 25-36 deal 3.5x damage for the next 3 spins.",
         effects: [payout_mult(target: dozen(3), value: 3.5, duration: spins(3))]),
        (id: "jackpot_trio", name: "Jackpot Trio", cost: 3, card_type: payout, rarity: rare,
         description: "Betting on 7, 11, or 21 deals 250x damage for the rest of the fight.",
         effects: [custom_number_mult(numbers: [7, 11, 21], mult: 250.0)]),
        (id: "devils_trio", name: "Devil's Trio", cost: 3, card_type: payout, rarity: rare,
         description: "Betting on 6, 16, or 26 deals 250x damage for the rest of the fight.",
         effects: [custom_number_mult(numbers: [6, 16, 26], mult: 250.0)]),
        (id: "single_out", name: "Single Out", cost: 1, card_type: payout, rarity: common,
         description: "Single number bets deal 40x damage for the next 3 spins.",
         effects: [payout_mult(target: single_number, value: 40.0, duration: spins(3))]),
        (id: "double_payout", name: "Double Payout", cost: 1, card_type: payout, rarity: uncommon,
         description: "Double the next successful number bet payout.",
         effects: [double_next_payout]),
        (id: "column_wave", name: "Column Wave", cost: 2, card_type: payout, rarity: uncommon,
         description: "Bets on Column 1 deal 4x damage for the next 3 spins.",
         effects: [payout_mult(target: column(1), value: 4.0, duration: spins(3))]),
        (id: "column_drift", name: "Column Drift", cost: 2, card_type: payout, rarity: uncommon,
         description: "Bets on Column 2 deal 4x damage for the next 3 spins.",
         effects: [payout_mult(target: column(2), value: 4.0, duration: spins(3))]),
        (id: "column_apex", name: "Column Apex", cost: 2, card_type: payout, rarity: uncommon,
         description: "Bets on Column 3 deal 4x damage for the next 3 spins.",
         effects: [payout_mult(target: column(3), value: 4.0, duration: spins(3))]),
        (id: "green_ripple", name: "Green Ripple", cost: 1, card_type: payout, rarity: uncommon,
         description: "Green bets deal +5x damage per active Green slot on the wheel.",
         effects: [green_ripple(mult_per_slot: 5.0)]),
        (id: "golden_zero", name: "Golden Zero", cost: 3, card_type: payout, rarity: rare,
         description: "0 bets deal 300x damage for the rest of the fight.",
         effects: [custom_number_mult(numbers: [0], mult: 300.0)]),

        // ============ PHYSICS (§6.3 physics table, sim values verbatim) ============
        (id: "friction_oil", name: "Friction Oil", cost: 2, card_type: physics, rarity: common,
         description: "Halves friction for the next spin. Predicts a 7-slot sector (landed slots inside sector suffer a 70% payout penalty).",
         effects: [physics(friction: 0.65, prediction_size: 7)]),
        (id: "lead_ball", name: "Lead Ball", cost: 2, card_type: physics, rarity: uncommon,
         description: "Double ball mass/friction. Bounces less and predicts a 5-slot landing sector.",
         effects: [physics(ball_mass: 2.0, friction: 2.0, bounce_randomness: 0.05, prediction_size: 5)]),
        (id: "table_tilt", name: "Wheel Tilt", cost: 2, card_type: physics, rarity: common,
         description: "Slightly tilts the roulette wheel, pulling the ball and predicting a 5-slot landing sector.",
         effects: [physics(wheel_tilt: 0.15, prediction_size: 5)]),
        (id: "magnetic_force", name: "Lodestone Magnet", cost: 4, card_type: physics, rarity: rare,
         description: "Grants 90% magnetic bias to land on a bet slot.",
         effects: [physics(target_zone_bias: 0.90)]),
        (id: "predictive_sight", name: "Predictive Sight", cost: 3, card_type: physics, rarity: uncommon,
         description: "Predicts a 3-slot sector (landed slots inside sector suffer a 50% payout penalty).",
         effects: [physics(prediction_size: 3)]),
        (id: "nudge_cheat", name: "Nudge Cheat", cost: 3, card_type: physics, rarity: rare,
         description: "Magnets shift outcome by up to ±3 slots towards bets to force a win.",
         effects: [physics(nudge_distance: 3)]),
        (id: "ice_glaze", name: "Ice Glaze", cost: 2, card_type: physics, rarity: common,
         description: "Reduces wheel friction to 0.1. Predicts a 9-slot sector (landed slots inside sector suffer a 70% payout penalty).",
         effects: [physics(friction: 0.3, prediction_size: 9)]),
        (id: "sand_trap", name: "Sand Trap", cost: 1, card_type: physics, rarity: uncommon,
         description: "Quintuples friction. Ball stops almost instantly and predicts a tight 3-slot sector.",
         effects: [physics(friction: 5.0, prediction_size: 3)]),
        (id: "heavy_core", name: "Heavy Core", cost: 2, card_type: physics, rarity: uncommon,
         description: "Increases ball mass by 5x (very low bounce). Predicts a tight 3-slot sector.",
         effects: [physics(ball_mass: 5.0, prediction_size: 3)]),
        (id: "light_shell", name: "Light Shell", cost: 1, card_type: physics, rarity: common,
         description: "Halves ball mass (heavy bounce). Predicts a wide 7-slot sector.",
         effects: [physics(ball_mass: 0.5, prediction_size: 7)]),
        (id: "steep_slope", name: "Steep Slope", cost: 2, card_type: physics, rarity: uncommon,
         description: "Increases wheel tilt to maximum. Predicts a tight 3-slot sector.",
         effects: [physics(wheel_tilt: 0.35, prediction_size: 3)]),
        (id: "emp_pulse", name: "Electromagnetic Pulse", cost: 4, card_type: physics, rarity: rare,
         description: "100% bias to land in slots with bets, and draw 3 cards next turn.",
         effects: [physics(target_zone_bias: 1.0), draw(count: 3)]),
        (id: "weak_magnet", name: "Weak Magnet", cost: 1, card_type: physics, rarity: common,
         description: "20% bias to land in slots with bets. Predicts a 5-slot sector.",
         effects: [physics(target_zone_bias: 0.2, prediction_size: 5)]),
        (id: "repulsion_coil", name: "Repulsion Coil", cost: 1, card_type: physics, rarity: uncommon,
         description: "Magnetically pushes ball away from Red slots. Predicts a 5-slot sector.",
         effects: [physics(bias_black_only: true, prediction_size: 5)]),
        (id: "attraction_coil", name: "Attraction Coil", cost: 1, card_type: physics, rarity: uncommon,
         description: "Magnetically pulls ball towards Black slots. Predicts a 5-slot sector.",
         effects: [physics(bias_red_only: true, prediction_size: 5)]),
        (id: "chaos_bounce", name: "Chaos Bounce", cost: 1, card_type: physics, rarity: common,
         description: "Multiplies bounce randomness by 3x. Predicts a wide 9-slot sector.",
         effects: [physics(bounce_randomness: 0.3, prediction_size: 9)]),
        (id: "sticky_track", name: "Sticky Track", cost: 1, card_type: physics, rarity: uncommon,
         description: "Reduces bounce randomness to 0. Predicts a tight 5-slot sector.",
         effects: [physics(bounce_randomness: 0.0, prediction_size: 5)]),
        (id: "eagle_eye", name: "Eagle Eye", cost: 4, card_type: physics, rarity: rare,
         description: "Predicts a pinpoint 1-slot sector. Draw 1 card.",
         effects: [physics(prediction_size: 1), draw(count: 1)]),
        (id: "omniscience", name: "Omniscience", cost: 5, card_type: physics, rarity: legendary,
         description: "Predicts a pinpoint 1-slot sector and deals 3x damage. Draw 2 cards and gain +3 actions (+12 Essence).",
         effects: [physics(prediction_size: 1), action_surge(chips: 12), draw(count: 2)]),
        (id: "broad_vision", name: "Broad Vision", cost: 2, card_type: physics, rarity: common,
         description: "Highlights a wide 9-slot sector (landed slots inside sector suffer a 70% payout penalty).",
         effects: [physics(prediction_size: 9)]),
        (id: "focus_sight", name: "Focus Sight", cost: 2, card_type: physics, rarity: common,
         description: "Highlights a 5-slot sector.",
         effects: [physics(prediction_size: 5)]),
        (id: "predictive_sight_plus", name: "Predictive Sight+", cost: 0, card_type: physics, rarity: uncommon,
         description: "Highlights a tight 3-slot sector, but draw 1 less card next turn.",
         effects: [physics(prediction_size: 3)]),
        (id: "heavy_nudge", name: "Heavy Nudge", cost: 4, card_type: physics, rarity: legendary,
         description: "Shifts outcome by up to ±5 slots to force a bet win. Gain 15 Essence on failure.",
         effects: [physics(nudge_distance: 5), grant_chips(amount: 15)]),
        (id: "micro_nudge", name: "Micro Nudge", cost: 1, card_type: physics, rarity: uncommon,
         description: "Shifts outcome by ±1 slot, but only if bet on that slot is >5.",
         effects: [physics(nudge_distance: 1)]),
        (id: "wind_tunnel", name: "Wind Tunnel", cost: 1, card_type: physics, rarity: uncommon,
         description: "Shifts final outcome in the direction of wheel rotation by +1 slot.",
         effects: [physics(nudge_distance: 1)]),
        (id: "slow_spin", name: "Calm Spin", cost: 1, card_type: physics, rarity: common,
         description: "Halves the wheel spin speed. Predicts a wide 7-slot sector.",
         effects: [physics(spin_speed: 0.5, prediction_size: 7)]),
        (id: "turbo_spin", name: "Turbo Spin", cost: 1, card_type: physics, rarity: uncommon,
         description: "Doubles wheel speed. Predicts 9-slot sector, but wins deal 1.5x damage.",
         effects: [physics(spin_speed: 2.0, prediction_size: 9), payout_mult(target: single_number, value: 1.5, duration: spins(1))]),

        // ============ CHAOS (ball multiplication) ============
        (id: "triple_threat", name: "Triple Threat", cost: 1, card_type: chaos, rarity: rare,
         description: "Spins 3 balls simultaneously on your wheel this turn.",
         effects: [physics(multiball: 3)]),
        (id: "peg_splitter", name: "Peg Splitter", cost: 1, card_type: chaos, rarity: legendary,
         description: "When the ball hits a pin, it duplicates into 2 balls (max 6 active balls).",
         effects: [physics(split_peg: true)]),
        (id: "shotgun_blast", name: "Shotgun Blast", cost: 1, card_type: chaos, rarity: rare,
         description: "Spins 1 ball. After 1.5 seconds, it duplicates into a shotgun blast of 4 extra balls.",
         effects: [physics(shotgun: true)]),

        // ============ BOARD (wheel/board alterations) ============
        (id: "crimson_flood", name: "Crimson Flood", cost: 1, card_type: board, rarity: uncommon,
         description: "Converts numbers 1 to 6 into Red on the wheel (increasing Red odds).",
         effects: [convert_slots(to: red, numbers: range(1, 6), scope: fight)]),
        (id: "abyssal_darkness", name: "Abyssal Darkness", cost: 1, card_type: board, rarity: uncommon,
         description: "Converts numbers 13 to 18 into Black on the wheel (increasing Black odds).",
         effects: [convert_slots(to: black, numbers: range(13, 18), scope: fight)]),
        (id: "emerald_rift", name: "Emerald Rift", cost: 1, card_type: board, rarity: uncommon,
         description: "Adds an extra Green slot (0 and 32 are both Green).",
         effects: [add_green_slot(number: 32)]),
        (id: "crimson_deluge", name: "Crimson Deluge", cost: 1, card_type: board, rarity: rare,
         description: "Converts numbers 1 to 18 into Red on the wheel (half the wheel).",
         effects: [convert_slots(to: red, numbers: range(1, 18), scope: fight)]),
        (id: "onyx_tsunami", name: "Onyx Tsunami", cost: 1, card_type: board, rarity: rare,
         description: "Converts numbers 19 to 36 into Black on the wheel (half the wheel).",
         effects: [convert_slots(to: black, numbers: range(19, 36), scope: fight)]),
        (id: "jade_path", name: "Jade Path", cost: 1, card_type: board, rarity: rare,
         description: "Adds 4 extra Green slots (0, 5, 11, 17, 22, and 29 are Green).",
         effects: [add_green_slot(number: 5), add_green_slot(number: 11),
                   add_green_slot(number: 17), add_green_slot(number: 22),
                   add_green_slot(number: 29)]),
        (id: "color_shift_red", name: "Color Shift Red", cost: 1, card_type: board, rarity: uncommon,
         description: "Converts all Black slots under 15 to Red.",
         effects: [convert_slots(to: red, from: black, numbers: below(15), scope: fight)]),
        (id: "color_shift_black", name: "Color Shift Black", cost: 1, card_type: board, rarity: uncommon,
         description: "Converts all Red slots over 20 to Black.",
         effects: [convert_slots(to: black, from: red, numbers: above(20), scope: fight)]),
        (id: "emerald_forest", name: "Emerald Forest", cost: 1, card_type: board, rarity: legendary,
         description: "Converts all prime numbers to Green and doubles Green payouts for this fight.",
         effects: [convert_slots(to: green, numbers: prime, scope: fight), emerald_forest]),
        (id: "monochrome", name: "Monochrome", cost: 1, card_type: board, rarity: uncommon,
         description: "Swaps all colors: Red becomes Black, Black becomes Red.",
         effects: [swap_red_black(scope: fight)]),
        (id: "blood_spill", name: "Blood Spill", cost: 1, card_type: board, rarity: uncommon,
         description: "Converts 3 random wheel slots to Red for the next 5 spins.",
         effects: [convert_slots(to: red, numbers: random_slots(3), scope: round)]),
        (id: "lucky_zone", name: "Lucky Zone", cost: 1, card_type: board, rarity: uncommon,
         description: "Mark a 3-slot zone on the board; bets on this zone deal +1.5x damage.",
         effects: [zone_mark(kind: lucky, count: 3)]),
        (id: "cursed_zone", name: "Cursed Zone", cost: 1, card_type: board, rarity: rare,
         description: "Mark a 5-slot zone; if ball lands here, enemy is stunned for 2 turns.",
         effects: [zone_mark(kind: cursed, count: 5, value: 2)]),
        (id: "chip_mine", name: "Chip Mine", cost: 1, card_type: board, rarity: uncommon,
         description: "Mark a number slot. If ball lands here, gain 15 chips.",
         effects: [zone_mark(kind: chip_mine, count: 1, value: 15)]),
        (id: "zero_eclipse", name: "Zero Eclipse", cost: 1, card_type: board, rarity: uncommon,
         description: "0 becomes a Black slot, and its payout becomes Red.",
         effects: [convert_slots(to: black, numbers: list([0]), scope: fight),
                   custom_number_mult(numbers: [0], mult: 2.0)]),
        (id: "mirror_slot", name: "Mirror Slot", cost: 1, card_type: board, rarity: uncommon,
         description: "Mark one slot. If ball lands on the mirrored slot opposite it, you win too.",
         effects: [zone_mark(kind: mirror, count: 1)]),
        (id: "danger_zone", name: "Danger Zone", cost: 1, card_type: board, rarity: rare,
         description: "Converts 5 slots into red spikes. If enemy lands there, they take 50 flat damage.",
         effects: [zone_mark(kind: danger_zone, count: 5, value: 50)]),
        (id: "gold_foil", name: "Gold Foil", cost: 1, card_type: board, rarity: legendary,
         description: "Mark 1 slot. Landing there multiplies that slot's damage by 10x.",
         effects: [zone_mark(kind: gold_foil, count: 1)]),
        (id: "copper_plate", name: "Copper Plate", cost: 1, card_type: board, rarity: common,
         description: "Mark 3 slots. Landing there multiplies their damage by 1.5x.",
         effects: [zone_mark(kind: copper_plate, count: 3)]),
        (id: "red_sea", name: "Red Sea", cost: 1, card_type: board, rarity: rare,
         description: "Converts all Black slots into Red slots for the next spin.",
         effects: [convert_slots(to: red, from: black, numbers: all, scope: spin)]),

        // ============ PAINT (temporary recoloring — round-scoped) ============
        (id: "paint_red", name: "Red Paint", cost: 1, card_type: paint, rarity: uncommon,
         description: "Converts 5 random Black slots into Red slots for the round.",
         effects: [convert_slots(to: red, from: black, numbers: random_slots(5), scope: round)]),
        (id: "paint_black", name: "Black Paint", cost: 1, card_type: paint, rarity: uncommon,
         description: "Converts 5 random Red slots into Black slots for the round.",
         effects: [convert_slots(to: black, from: red, numbers: random_slots(5), scope: round)]),
        (id: "paint_green", name: "Green Coat", cost: 1, card_type: paint, rarity: uncommon,
         description: "Converts 3 random Red or Black slots into Green slots for the round.",
         effects: [convert_slots(to: green, numbers: random_slots(3), scope: round)]),
        (id: "paint_gold", name: "Gold Glaze", cost: 1, card_type: paint, rarity: rare,
         description: "Converts 2 random slots into Gold slots for the round.",
         effects: [convert_slots(to: gold, numbers: random_slots(2), scope: round)]),
        (id: "paint_purple", name: "Purple Dye", cost: 1, card_type: paint, rarity: rare,
         description: "Converts 2 random slots into Purple slots for the round.",
         effects: [convert_slots(to: purple, numbers: random_slots(2), scope: round)]),
        (id: "paint_cyan", name: "Cyan Tint", cost: 1, card_type: paint, rarity: rare,
         description: "Converts 2 random slots into Cyan slots for the round.",
         effects: [convert_slots(to: cyan, numbers: random_slots(2), scope: round)]),
        (id: "paint_crimson", name: "Crimson Spray", cost: 1, card_type: paint, rarity: rare,
         description: "Converts 2 random slots into Crimson slots for the round.",
         effects: [convert_slots(to: crimson, numbers: random_slots(2), scope: round)]),
        (id: "paint_complementary", name: "Complementary Splash", cost: 1, card_type: paint, rarity: rare,
         description: "Converts all Black slots into Red slots for the round.",
         effects: [convert_slots(to: red, from: black, numbers: all, scope: round)]),
        (id: "paint_inverse", name: "Inverse Splash", cost: 1, card_type: paint, rarity: rare,
         description: "Converts all Red slots into Black slots for the round.",
         effects: [convert_slots(to: black, from: red, numbers: all, scope: round)]),
        (id: "paint_single_digit", name: "Single Digit Splash", cost: 1, card_type: paint, rarity: rare,
         description: "Converts all single-digit slots (1-9) into Green slots for the round.",
         effects: [convert_slots(to: green, numbers: single_digit, scope: round)]),
        (id: "paint_prime", name: "Prime Coat", cost: 1, card_type: paint, rarity: rare,
         description: "Converts all prime number slots on the wheel into Green slots for the round.",
         effects: [convert_slots(to: green, numbers: prime, scope: round)]),
        (id: "paint_high_gild", name: "High Roller Gild", cost: 1, card_type: paint, rarity: legendary,
         description: "Converts all High slots (19-36) into Gold slots for the round.",
         effects: [convert_slots(to: gold, numbers: high, scope: round)]),

        // ============ UTILITY (economy / draw / turn tricks) ============
        (id: "double_down", name: "Double Down", cost: 1, card_type: utility, rarity: uncommon,
         description: "Double all bets placed, but double the enemy damage taken if you miss.",
         effects: [double_down]),
        (id: "risk_capital", name: "Risk Capital", cost: 1, card_type: utility, rarity: uncommon,
         description: "Gain 10 chips, but lose 2 chips per spin for the rest of the fight.",
         effects: [risk_capital(gain: 10, drain_per_spin: 2)]),
        (id: "insurance_policy", name: "Insurance Policy", cost: 1, card_type: utility, rarity: uncommon,
         description: "If you win this spin, gain 0 chips. If you lose, refund all chips bet.",
         effects: [insurance]),
        (id: "quick_draw", name: "Quick Draw", cost: 1, card_type: utility, rarity: common,
         description: "Draw 2 cards. Costs 1 chip instead of 2.",
         effects: [draw(count: 2)]),
        (id: "heavy_draw", name: "Heavy Draw", cost: 1, card_type: utility, rarity: uncommon,
         description: "Draw 3 cards, but discard 1 card.",
         effects: [draw(count: 3), discard_random(count: 1)]),
        (id: "deck_shuffle", name: "Deck Shuffle", cost: 0, card_type: utility, rarity: common,
         description: "Shuffle discard pile back into draw pile. Draw 1 card.",
         effects: [hand_op(kind: reshuffle), draw(count: 1)]),
        (id: "calculated_risk", name: "Calculated Risk", cost: 1, card_type: utility, rarity: uncommon,
         description: "Discard your entire hand. Draw that many cards.",
         effects: [discard_hand_then_draw_equal]),
        (id: "golden_mirror", name: "Golden Mirror", cost: 1, card_type: utility, rarity: rare,
         description: "Choose 1 card; add 2 temporary copies of it to hand with 0 cost.",
         effects: [hand_op(kind: copy_random_hand_card)]),
        (id: "copy_paste", name: "Copy Paste", cost: 1, card_type: utility, rarity: uncommon,
         description: "Copy the last played non-utility card.",
         effects: [hand_op(kind: copy_last_played)]),
        (id: "recycle_bin", name: "Recycle Bin", cost: 1, card_type: utility, rarity: uncommon,
         description: "Retrieve 1 card from discard pile into your hand.",
